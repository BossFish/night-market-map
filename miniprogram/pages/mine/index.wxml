<view class="page">

  <view class="state" wx:if="{{loading}}">{{T.mineSettingUp}}</view>

  <view class="state state--error" wx:elif="{{error}}" bindtap="onRetry">
    {{T.mineFailed}}：{{error}} · {{T.mineRetry}}
  </view>

  <block wx:else>

    <view class="profile">
      <view class="profile__avatar">{{avatarChar}}</view>
      <view class="profile__name">{{displayName}}</view>
      <view class="profile__welcome" wx:if="{{isNew}}">{{T.mineWelcome}}</view>
      <view class="profile__note">{{T.mineNote}}</view>
    </view>

    <view class="section">
      <view class="section__title">{{T.mineMyRatings}}</view>

      <view class="empty" wx:if="{{myRatings.length === 0}}">{{T.myRatingsEmpty}}</view>

      <view class="rating" wx:for="{{myRatings}}" wx:key="zoneId" wx:for-item="zone">
        <view class="rating__head">
          <text class="rating__name">{{zone.name}}</text>
          <text class="rating__status {{zone.pending ? 'rating__status--pending' : ''}}">
            {{zone.pending ? T.ratingStatusPending : T.ratingStatusActive}}
          </text>
        </view>

        <view class="stars">
          <text
            wx:for="{{zone.starItems}}"
            wx:key="value"
            wx:for-item="star"
            class="star {{star.on ? 'star--on' : ''}}"
            data-zone="{{zone.zoneId}}"
            data-star="{{star.value}}"
            bindtap="onChangeStars"
          >★</text>
        </view>
        <view class="rating__hint">{{T.myRatingsChangeHint}}</view>

        <view class="aspects">
          <view class="aspect" wx:for="{{zone.aspectRows}}" wx:key="dimensionKey" wx:for-item="row">
            <text
              wx:for="{{row.options}}"
              wx:key="value"
              wx:for-item="opt"
              class="chip {{opt.selected ? 'chip--on' : ''}}"
              data-zone="{{zone.zoneId}}"
              data-dimension="{{row.dimensionKey}}"
              data-value="{{opt.value}}"
              bindtap="onPickAspect"
            >{{opt.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="explain">{{T.mineExplain}}</view>

  </block>

</view>

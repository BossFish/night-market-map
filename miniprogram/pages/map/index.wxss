.map {
  width: 100%;
  height: 100vh;
}

/* ---------- 右上角「我的」入口 ---------- */

.mine {
  position: fixed;
  top: 24rpx;
  right: 24rpx;
  z-index: 20;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.16);
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 500;
}

/* ---------- 打过分的夜市：会晃的星星气泡 ---------- */

.bubble {
  position: fixed;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  /* 用负外边距把气泡中心对到坐标点上。
     不用 translate 居中是为了把 transform 让给晃动动画。 */
  margin: -32rpx 0 0 -32rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  font-size: 34rpx;
  line-height: 1;
  animation: bubble-wobble 2.4s ease-in-out infinite;
  /* 点击穿透到地图上，免得气泡挡住它下面那个区域的点击 */
  pointer-events: none;
}

@keyframes bubble-wobble {
  0% {
    transform: rotate(-7deg) scale(1);
  }
  50% {
    transform: rotate(7deg) scale(1.12);
  }
  100% {
    transform: rotate(-7deg) scale(1);
  }
}

/* ---------- 摊位名字 ---------- */

.stall-label {
  position: fixed;
  z-index: 13;
  padding: 4rpx 12rpx;
  /* 默认贴在坐标点（方框上边）的上方 */
  transform: translate(-50%, -100%);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.16);
  color: #9A3412;
  font-size: 20rpx;
  line-height: 1.5;
  white-space: nowrap;
  /* 点名字等于点它下面那个摊位 */
  pointer-events: none;
}

.stall-label--below {
  transform: translate(-50%, 0);
}

/* ---------- 底部提示条 ---------- */

.hint {
  position: fixed;
  left: 50%;
  bottom: 64rpx;
  z-index: 15;
  padding: 14rpx 32rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: rgba(20, 24, 31, 0.8);
  color: #F9FAFB;
  font-size: 24rpx;
  /* 让点击穿过提示条落到地图上，避免底部出现一小块点不动的死区 */
  pointer-events: none;
}

.errorbar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 64rpx;
  z-index: 16;
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(153, 27, 27, 0.92);
  color: #FEE2E2;
  font-size: 24rpx;
  text-align: center;
}

/* ---------- 区域详情卡片 ---------- */

.card {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 18rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #FFFFFF;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.16);
  animation: card-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.card--closing {
  animation: card-out 180ms ease-in forwards;
}

/* 被摊位卡片盖住的夜市卡片：变灰、退到后面 */
.card--dimmed {
  z-index: 20;
  filter: grayscale(1);
  opacity: 0.5;
}

/* 摊位卡片压在夜市卡片上面 */
.card--stall {
  z-index: 40;
  max-height: 68vh;
  overflow-y: auto;
}

/* ---------- 价目表 ---------- */

.menu {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--divider);
}

.menu__block {
  margin-bottom: 20rpx;
}

.menu__block:last-child {
  margin-bottom: 0;
}

.menu__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.menu__name {
  flex: 1;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.menu__price {
  flex-shrink: 0;
  color: #EA580C;
  font-size: 30rpx;
  font-weight: 600;
}

.menu__note {
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.menu__option {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-left: 20rpx;
}

.menu__option-name {
  flex: 1;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.menu__option-price {
  flex-shrink: 0;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.menu__empty {
  margin-top: 20rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

@keyframes card-in {
  from {
    transform: translateY(100%);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes card-out {
  from {
    transform: translateY(0);
    opacity: 1;
  }
  to {
    transform: translateY(100%);
    opacity: 0;
  }
}

.card__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: var(--divider);
}

.card__title {
  color: var(--text-primary);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card__sub {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.card__rows {
  margin-top: 22rpx;
}

.card__row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.card__label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--text-secondary);
}

.card__value {
  flex: 1;
  color: var(--text-primary);
}

.card__value--muted {
  color: var(--text-muted);
}

/* ---------- 打分 ---------- */

.rate {
  flex: 1;
}

.rate__top {
  display: flex;
  align-items: center;
}

.stars {
  display: flex;
  align-items: center;
  margin-left: -8rpx;
}

.star {
  padding: 0 8rpx;
  color: #D1D5DB;
  font-size: 46rpx;
  line-height: 1.1;
}

.star--on {
  color: #F59E0B;
}

.rate__hint {
  margin-top: 2rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.rate__status {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: #DCFCE7;
  color: #166534;
  font-size: 22rpx;
}

.rate__status--pending {
  background: #FEF3C7;
  color: #92400E;
}

/* ---------- 四个维度 ---------- */

.aspects {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
}

.aspect {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.aspect:last-child {
  margin-bottom: 0;
}

.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--divider);
  border-radius: 999rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.chip--on {
  border-color: var(--brand-green);
  background: #F0FDF4;
  color: var(--brand-green-dark);
  font-weight: 500;
}
